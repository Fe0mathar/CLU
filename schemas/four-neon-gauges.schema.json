{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLU-E Four Neon Gauges",
  "type": "object",
  "required": ["schemaVersion", "capturedAt", "configurationHash", "gauges", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "capturedAt": { "type": "string" },
    "configurationHash": { "type": ["string", "null"] },
    "gauges": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["slot", "definitionId", "metricId", "metricName", "family", "familyColor", "projectionType", "nativeValue", "normalizedValue", "dialPosition", "gateState", "trend", "confidence", "coverage", "freshness", "availability"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 4 },
          "definitionId": { "type": "string" },
          "metricId": { "type": "string", "pattern": "^M[A-K][0-9]{2}$" },
          "metricName": { "type": "string" },
          "family": { "enum": ["TARGET_QUALITY", "EVIDENCE_ASSURANCE", "ACCEPTANCE_GATES", "CLUE_SELF"] },
          "familyColor": { "type": "string" },
          "projectionType": { "type": "string" },
          "nativeValue": { "type": "object" },
          "normalizedValue": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
          "dialPosition": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "gateState": { "type": ["string", "null"], "enum": ["PASS", "WARNING", "FAIL", "UNKNOWN", null] },
          "trend": { "enum": ["improving", "stable", "worsening", "unknown"] },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "freshness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "availability": { "enum": ["available", "stale", "unknown", "not_applicable"] }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
